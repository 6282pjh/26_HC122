# GPU 서버 공통 경로 설정 — 다른 스크립트가 전부 이 파일을 source 한다.
# 서버가 바뀌면 이 파일만 고치면 됨(절대경로 하드코딩 금지).
#
#   - 모든 경로는 HDD_BASE 아래에 만든다: PROJECT_ROOT=$HDD_BASE/hanium, conda env는 경로(-p)로 생성.
#   - pip/conda/torch/triton 캐시와 TMPDIR도 PROJECT_ROOT 아래에 둔다.
#   - 이 변수들은 setup_env.sh가 env의 activate.d에도 써 넣어서,
#     `conda activate` 만 하면 infer_lora.py 같이 project.env를 안 읽는 스크립트도 같은 HF_HOME을 쓴다.
#
# 폴더 구조:
#   $PROJECT_ROOT/code/      diffusers 포크
#   $PROJECT_ROOT/data/      dataset/train, dataset/test, cache/
#   $PROJECT_ROOT/lora_checkpoints/<날짜>_<실험명>/
#   $PROJECT_ROOT/hf_cache/  HuggingFace 캐시(모델 가중치 약 21.1GB) + HF 토큰
#   $PROJECT_ROOT/eval/      평가 영상
#   $PROJECT_ROOT/.cache/    pip·conda·torch·triton 캐시, tmp

export HDD_BASE="${HDD_BASE:-$HOME}"          # 대용량 디스크 경로
export PROJECT_ROOT="${PROJECT_ROOT:-$HDD_BASE/hanium}"
export CONDA_ENV="${CONDA_ENV:-cosmos_surgical}"
export CONDA_ENV_PREFIX="${CONDA_ENV_PREFIX:-$HDD_BASE/envs/$CONDA_ENV}"
export HF_HOME="${HF_HOME:-$PROJECT_ROOT/hf_cache}"
export DIFFUSERS_DIR="$PROJECT_ROOT/code/diffusers"

# 캐시·임시 폴더를 HDD로
export PIP_CACHE_DIR="${PIP_CACHE_DIR:-$PROJECT_ROOT/.cache/pip}"
export TORCH_HOME="${TORCH_HOME:-$PROJECT_ROOT/.cache/torch}"
export TRITON_CACHE_DIR="${TRITON_CACHE_DIR:-$PROJECT_ROOT/.cache/triton}"
export TMPDIR="${TMPDIR_HANIUM:-$PROJECT_ROOT/.cache/tmp}"

# 1차 환경(2026-08-18 pip freeze 기준) 고정 버전
export PY_VERSION="3.10.12"
export DIFFUSERS_REPO="https://github.com/terarachang/diffusers.git"
export DIFFUSERS_BRANCH="cosmos_predict_2.5_lora_clean"
export DIFFUSERS_COMMIT="13cfbb039abfb4680bf1ba5269c93e1b6cab5dea"
export MODEL_ID="${MODEL_ID:-nvidia/Cosmos-Predict2.5-2B}"
export MODEL_REVISION="${MODEL_REVISION:-diffusers/base/post-trained}"

export TOKENIZERS_PARALLELISM=false
